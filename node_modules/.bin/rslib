#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/jimmy/Projects/@jimmyolo/u-expresso/node_modules/.pnpm/@rslib+core@0.21.5/node_modules/@rslib/core/node_modules:/home/jimmy/Projects/@jimmyolo/u-expresso/node_modules/.pnpm/@rslib+core@0.21.5/node_modules:/home/jimmy/Projects/@jimmyolo/u-expresso/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/jimmy/Projects/@jimmyolo/u-expresso/node_modules/.pnpm/@rslib+core@0.21.5/node_modules/@rslib/core/node_modules:/home/jimmy/Projects/@jimmyolo/u-expresso/node_modules/.pnpm/@rslib+core@0.21.5/node_modules:/home/jimmy/Projects/@jimmyolo/u-expresso/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@rslib/core/bin/rslib.js" "$@"
else
  exec node  "$basedir/../@rslib/core/bin/rslib.js" "$@"
fi
