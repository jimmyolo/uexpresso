{
  "name": "@jimmyolo/u-expresso",
  "version": "2.7.3",
  "description": "☄️ fast http server, based on μWebSockets.js. save your time ☕",
  "scripts": {
    "prepare": "npx husky",
    "deps:prune-cooldown": "node scripts/prune-release-age-exclude.js",
    "deps:prune-cooldown:check": "node scripts/prune-release-age-exclude.js --check",
    "test": "node tests",
    "test:coverage": "node --experimental-test-coverage tests",
    "test:types": "aube run pack && tsd",
    "clean": "rm -rf build coverage",
    "build:npm": "BUILD_TARGET=npm aube run build",
    "release": "npx release-it --verbose",
    "release:dry": "aube run release -- --dry-run --ci",
    "coverage": "aube run coverage:unit && aube run coverage:report",
    "np:npm": "aube run clean && BUILD_TARGET=npm aube run build && aube publish --dir build --registry=https://registry.npmjs.org/",
    "bench": "node benchmark/run.js",
    "bench:compare": "node benchmark/compare/run.js",
    "bench:single": "node benchmark/compare/run.js --single",
    "bench:uws-api": "node benchmark/uws-api/run.js",
    "ai:init": "codegraph init -i",
    "ai:status": "codegraph status",
    "ai:sync": "codegraph sync",
    "ai:reindex": "codegraph index --force"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyolo/uexpresso.git"
  },
  "author": "jimmyolo <victor0801x@gmail.com>",
  "optionalDependencies": {
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.68.0",
    "ultimate-express": "2.1.1"
  },
  "dependencies": {
    "@jimmyolo/uws.js": "github:jimmyolo/uws.js#v20.68.0-alma.1",
    "bytes": "^3.1.2",
    "content-disposition": "^1.1.0",
    "cookie": "^1.1.1",
    "cookie-signature": "^1.2.2",
    "etag": "^1.8.1",
    "fast-querystring": "^1.1.2",
    "fast-zlib": "^2.0.1",
    "proxy-addr": "^2.0.7",
    "range-parser": "^1.2.1",
    "statuses": "^2.0.2",
    "tseep": "^1.3.1",
    "@types/express": "^4.17.25",
    "express": "^4.22.2"
  }
}