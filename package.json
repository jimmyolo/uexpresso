{
  "name": "@jimmyolo/u-expresso",
  "version": "2.8.8",
  "description": "☄️ fast http server, based on μWebSockets.js. save your time ☕",
  "scripts": {
    "deps:prune-cooldown": "node scripts/prune-release-age-exclude.js",
    "deps:prune-cooldown:check": "node scripts/prune-release-age-exclude.js --check",
    "test": "node tests",
    "test:coverage": "node --experimental-test-coverage tests",
    "test:route-index": "node scripts/fuzz-route-index.js",
    "test:types": "aube run pack && tsd",
    "test:types:pack": "node tests/types-packaging.mjs",
    "test:publish-stash": "node tests/publish-stash-guard.mjs",
    "check": "aubx @biomejs/biome check --no-errors-on-unmatched",
    "lint": "aube run check -- --staged --linter-enabled=true --formatter-enabled=false",
    "lint:fix": "aube run lint --fix",
    "format": "aube run check -- --staged --linter-enabled=false --formatter-enabled=true",
    "format:fix": "aube run format --fix",
    "clean": "rm -rf build coverage",
    "build:npm": "BUILD_TARGET=npm aube run build",
    "release": "npx release-it --verbose",
    "release:dry": "aube run release -- --dry-run --ci",
    "coverage": "aube run coverage:unit && aube run coverage:report",
    "np:npm": "aube run clean && BUILD_TARGET=npm aube run build && aube publish --dir build --registry=https://registry.npmjs.org/",
    "bench": "node benchmark/run.js",
    "bench:compare": "node benchmark/compare/run.js",
    "bench:single": "node benchmark/compare/run.js --single",
    "bench:body-parser-branch": "node benchmark/compare/bin/bench-body-parser-vs-branch.js",
    "bench:js-layer": "node benchmark/js-layer/run.mjs",
    "bench:router": "node benchmark/router/run.js",
    "bench:uws-api": "node benchmark/uws-api/run.js",
    "ai:init": "codegraph init -i",
    "ai:status": "codegraph status",
    "ai:sync": "codegraph sync",
    "ai:reindex": "codegraph index --force",
    "bench:cross": "bash benchmark/cross/run-container.sh",
    "bench:cross:host": "node benchmark/cross/run.ts"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": "aubx @biomejs/biome check --write --no-errors-on-unmatched"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyolo/uexpresso.git"
  },
  "author": "jimmyolo <victor0801x@gmail.com>",
  "optionalDependencies": {
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.69.0"
  },
  "dependencies": {
    "@types/express": "^4.17.25",
    "@jimmyolo/uws.js": "github:jimmyolo/uws.js#v20.69.0-alma.1",
    "bytes": "^3.1.2",
    "content-disposition": "^1.1.0",
    "cookie": "^2.0.1",
    "cookie-signature": "^1.2.2",
    "etag": "^1.8.1",
    "fast-querystring": "^1.1.2",
    "proxy-addr": "^2.0.7",
    "range-parser": "^1.3.0",
    "statuses": "^2.0.2",
    "tseep": "^1.3.1",
    "express": "~4.22.2"
  }
}