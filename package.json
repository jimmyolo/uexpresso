{
  "name": "@jimmyolo/u-expresso",
  "version": "2.0.5-beta.2",
  "description": "☄️ fast http server, based on μWebSockets.js. save your time ☕",
  "scripts": {
    "prepare": "npx husky",
    "test": "node tests",
    "test:coverage": "node --experimental-test-coverage tests",
    "clean": "rm -rf build coverage",
    "release": "npx release-it --verbose",
    "coverage": "npm run coverage:unit && npm run coverage:report",
    "np:npm": "npm run clean && BUILD_TARGET=npm npm run build -- npm && npm publish --registry=https://registry.npmjs.org/ build/"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyolo/uexpresso.git"
  },
  "author": "jimmyolo <victor0801x@gmail.com>",
  "optionalDependencies": {
    "ultimate-express": "2.0.17",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.57.0"
  },
  "dependencies": {
    "@jimmyolo/uws-alma": "github:jimmyolo/uWebSockets.js#v20.57.0",
    "bytes": "^3.1.2",
    "cookie": "^1.1.1",
    "cookie-signature": "^1.2.2",
    "etag": "^1.8.1",
    "fast-zlib": "^2.0.1",
    "proxy-addr": "^2.0.7",
    "range-parser": "^1.2.1",
    "statuses": "^2.0.2",
    "tseep": "^1.3.1",
    "@types/express": "^4.17.25",
    "express": "^4.22.1"
  }
}