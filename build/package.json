{
  "name": "@jimmyolo/u-expresso",
  "version": "2.6.0",
  "description": "☄️ fast http server, based on μWebSockets.js. save your time ☕",
  "scripts": {
    "prepare": "npx husky",
    "test": "node tests",
    "test:coverage": "node --experimental-test-coverage tests",
    "clean": "rm -rf build coverage",
    "build:npm": "BUILD_TARGET=npm pnpm run build",
    "release": "npx release-it --verbose",
    "release:dry": "pnpm run release -- --dry-run --ci",
    "coverage": "pnpm run coverage:unit && pnpm run coverage:report",
    "np:npm": "pnpm run clean && BUILD_TARGET=npm pnpm run build && pnpm publish --registry=https://registry.npmjs.org/ build/",
    "bench": "node benchmark/run.js",
    "bench:compare": "node benchmark/compare/run.js",
    "bench:single": "node benchmark/compare/run.js --single",
    "bench:uws-api": "node benchmark/uws-api/run.js"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyolo/uexpresso.git"
  },
  "author": "jimmyolo <victor0801x@gmail.com>",
  "optionalDependencies": {
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#semver:v20.67.0",
    "ultimate-express": "2.1.0"
  },
  "dependencies": {
    "@jimmyolo/uws.js": "github:jimmyolo/uws.js#semver:v20.67.0-alma.1",
    "bytes": "^3.1.2",
    "content-disposition": "^1.1.0",
    "cookie": "^1.1.1",
    "cookie-signature": "^1.2.2",
    "etag": "^1.8.1",
    "fast-querystring": "^1.1.2",
    "fast-zlib": "^2.0.1",
    "proxy-addr": "^2.0.7",
    "range-parser": "^1.2.1",
    "statuses": "^2.0.2",
    "tseep": "^1.3.1",
    "@types/express": "^4.17.25",
    "express": "^4.22.2"
  },
  "scarfSettings": {
    "defaultOptIn": false
  },
  "packageManager": "pnpm@11.1.2"
}